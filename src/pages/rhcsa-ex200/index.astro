---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import LanguageSelector from '@/components/LanguageSelector.astro';
import { getUI, type Locale } from '@/lib/i18n';

const locale: Locale = 'es';
const ui = getUI(locale);
const posts = (await getCollection('rhcsa', ({ data }) => data.locale === locale && !data.draft))
  .sort((a, b) => a.data.moduleNumber - b.data.moduleNumber);
const completedModules = posts.filter((post) => post.data.completed).length;
const totalModules = posts.length || 1;
const completionPercent = Math.round((completedModules / totalModules) * 100);
---

<Layout
  locale={locale}
  basePath="rhcsa-ex200"
  title={`${ui.rhcsaBlogTitle} | Felipe Arce`}
  description={ui.rhcsaBlogDescription}
  ogTitle={ui.rhcsaBlogTitle}
  ogDescription={ui.rhcsaBlogDescription}
>
  <LanguageSelector locale={locale} />
  <main>
    <section>
      <a class="back-link" href="/#practicas-actuales">← Volver al CV</a>
      <h1>RHCSA EX200</h1>
      <p>{ui.rhcsaBlogDescription}</p>
      <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={completionPercent}>
        <div class="progress-fill" style={`width: ${completionPercent}%`} />
      </div>

      <section class="index-training" aria-labelledby="rhcsa-training-heading">
        <h2 id="rhcsa-training-heading">{ui.rhcsaIndexTrainingTitle}</h2>
        <ul class="training-list">
          <li>
            <a href="https://training-lms.redhat.com/" target="_blank" rel="noopener noreferrer">{ui.rhcsaIndexTrainingLmsLink}</a>
            {' — '}
            {ui.rhcsaIndexTrainingLmsNote}
          </li>
          <li>
            <a href="https://rol.redhat.com/rol/app/catalog" target="_blank" rel="noopener noreferrer">{ui.rhcsaIndexTrainingRolLink}</a>
          </li>
        </ul>
        <h3>{ui.rhcsaIndexRh134Title}</h3>
        <ul class="training-list">
          <li>
            <a href="https://rol.redhat.com/rol/app/courses/rh134-10.0" target="_blank" rel="noopener noreferrer">{ui.rhcsaIndexRh134Link}</a>
          </li>
        </ul>
        <p>{ui.rhcsaIndexTimelineNote}</p>
        <p>{ui.rhcsaIndexThanksNote}</p>
        <p>{ui.rhcsaIndexPlanNote}</p>
      </section>

      <ul class="module-list">
        {posts.map((post) => (
          <li>
            <a class="module-link" href={`/rhcsa-ex200/${post.id}/`}>
              <article class={post.data.completed ? 'module completed' : 'module pending'}>
                <header>
                  <h2>
                    {`${ui.rhcsaListClassPrefix} ${post.data.moduleNumber}: ${post.data.title}`}
                  </h2>
                  {post.data.completed && <span class="done-icon" aria-hidden="true">✓</span>}
                </header>
                <p>{`${ui.rhcsaListModuleLabel} ${post.data.moduleNumber}`}</p>
              </article>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  main {
    padding: 4rem;
    background-color: var(--color-bg-primary);
    color: var(--color-brand-primary);
    min-height: 100vh;
  }

  section {
    max-width: 700px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 12px;
    text-decoration: underline;
  }

  .index-training {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-primary);
  }

  .index-training h2 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .index-training h3 {
    font-size: 0.98rem;
    margin: 1rem 0 0.35rem;
  }

  .index-training .training-list {
    display: block;
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.35rem 0 0;
    gap: unset;
  }

  .index-training .training-list li {
    margin: 0.35rem 0;
    color: var(--color-text-primary);
  }

  .index-training p {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .index-training a {
    color: inherit;
    text-decoration: underline;
  }

  .index-training a:hover {
    color: inherit;
  }

  .module-list {
    display: grid;
    gap: 14px;
    margin-top: 20px;
    list-style: none;
    padding-left: 0;
  }

  .module-link {
    display: block;
  }

  .module {
    border: 1px solid var(--color-border-primary);
    border-radius: 10px;
    padding: 20px 16px;
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    transition: transform 120ms ease;
  }

  .module.completed {
    border-color: var(--color-border-medium);
    background: var(--color-bg-secondary);
  }

  .module.pending {
    border-color: var(--color-border-primary);
    background: var(--color-bg-secondary);
  }

  .module:hover {
    transform: translateY(-1px);
  }

  .progress-track {
    margin-top: 12px;
    width: 100%;
    height: 9px;
    border-radius: 999px;
    background: var(--color-border-medium);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-bg-dark);
  }

  h2 {
    font-size: 1.1rem;
    margin-bottom: 6px;
  }

  article p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .done-icon {
    color: var(--color-status-active);
    font-size: 1.4rem;
    font-weight: 700;
  }

  @media (width <= 700px) {
    main {
      padding: 1rem;
    }
  }
</style>
