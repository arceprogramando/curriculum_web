---
import {
  DEFAULT_LOCALE,
  getLocaleConfig,
  getOtherLocales,
  getUI,
  type Locale,
} from '@/lib/i18n';
import type { CvRole } from '@/lib/cv-print';
import { cvPrintPath } from '@/lib/cv-print';
import LanguageSelector from '@/components/LanguageSelector.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  role?: CvRole;
  /** Ruta canónica propia (ej. /crear-cv/). Si no hay, usa cvPrintPath(role). */
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  locale,
  title,
  description,
  ogTitle,
  ogDescription,
  role = 'general',
  path,
  ogImage = 'https://arceprog.dev/portada-og.png',
  ogImageAlt,
} = Astro.props;
const config = getLocaleConfig(locale);
const ui = getUI(locale);
const otherLocales = getOtherLocales(locale);
const canonicalPath = path ?? cvPrintPath(locale, role);
const canonicalUrl = `https://arceprog.dev${canonicalPath}`;
const alternatePath =
  path != null
    ? locale === 'es'
      ? path.replace(/^\/crear-cv/, '/en/crear-cv')
      : path.replace(/^\/en\/crear-cv/, '/crear-cv')
    : cvPrintPath(locale === 'es' ? 'en' : 'es', role);
const defaultAlternatePath =
  path != null
    ? path.replace(/^\/en\/crear-cv/, '/crear-cv').replace(/^\/crear-cv/, '/crear-cv')
    : cvPrintPath(DEFAULT_LOCALE, role);
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `https://arceprog.dev${ogImage}`;
const resolvedOgImageAlt = ogImageAlt ?? `${ogTitle} | arceprog.dev`;
const buildDate = new Date().toISOString();
---

<!doctype html>
<html lang={config.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="author" content="Felipe Arce" />
    <meta name="referrer" content="origin-when-cross-origin" />
    <meta http-equiv="content-language" content={locale} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#e8e6e1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Tipografía CV 2026 (IT / ATS):
      Source Sans 3 = sans moderna legible a 10–11pt (equivalente “Calibri-like” en web).
      Fallback: Calibri, Arial, Helvetica — las más citadas para ATS y CVs tech.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content="Felipe Arce Portfolio" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={config.ogLocale} />
    {
      otherLocales.map((loc) => (
        <meta property="og:locale:alternate" content={getLocaleConfig(loc).ogLocale} />
      ))
    }
    <meta property="og:updated_time" content={buildDate} />

    <link
      rel="alternate"
      hreflang={config.ogLocale.replace('_', '-')}
      href={canonicalUrl}
    />
    <link
      rel="alternate"
      hreflang={locale === 'es' ? 'en-US' : 'es-AR'}
      href={`https://arceprog.dev${alternatePath}`}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`https://arceprog.dev${defaultAlternatePath}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arceprog" />
    <meta name="twitter:creator" content="@arceprog" />
    <meta property="twitter:domain" content="arceprog.dev" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
  </head>
  <body>
    <a class="skip-link no-print" href="#main-content">{ui.skipToContent}</a>
    <LanguageSelector locale={locale} />
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: #e8e6e1;
    color: #111;
    font-family: 'Source Sans 3', Calibri, Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
  }

  :focus {
    outline: none;
  }

  :focus-visible {
    outline: 2px solid #0b57d0;
    outline-offset: 2px;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 1000;
    transform: translateY(-200%);
    background: #111;
    color: #fff;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
  }

  .skip-link:focus {
    transform: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media print {
    @page {
      size: letter;
      margin: 0.32in 0.45in;
    }

    html,
    body {
      background: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .no-print {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
