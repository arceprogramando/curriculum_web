---
import {
  getCV,
  getLocaleConfig,
  getAllLocaleUrls,
  getLocalePath,
  getOtherLocales,
  getUI,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale
} from '@/lib/i18n';
import SiteHeadIcons from '@/components/SiteHeadIcons.astro';
import '@/styles/theme.css';

/**
 * WhatsApp es más estricto que FB: JPEG bajo 300KB, URL absoluta sin ?v=,
 * OG al inicio del head. Cache-bust = cambiar el path del archivo.
 */
const DEFAULT_OG_IMAGE = '/og-wa.png';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  basePath?: string;
  noIndex?: boolean;
  locale?: Locale;
}

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = DEFAULT_OG_IMAGE,
  basePath,
  noIndex = false
} = Astro.props;
const config = getLocaleConfig(locale);
const ui = getUI(locale);
const cv = getCV(locale);
const { image } = cv.basics;

const currentPath = Astro.url.pathname;
const normalizedBasePath = (basePath ?? (locale === DEFAULT_LOCALE
  ? currentPath
  : currentPath.replace(new RegExp(`^/${locale}`), ''))).replace(/^\/|\/$/g, '');
const canonicalUrl = `https://arceprog.dev${getLocalePath(locale, normalizedBasePath)}`;
const localeUrls = getAllLocaleUrls(normalizedBasePath);
const otherLocales = getOtherLocales(locale);
const resolvedTitle = title ?? config.pageTitle;
const resolvedDescription = description ?? config.metaDescription;
const resolvedOgTitle = ogTitle ?? config.ogTitle;
const resolvedOgDescription = ogDescription ?? config.ogDescription;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `https://arceprog.dev${ogImage}`;
const ogImageIsJpeg = /\.jpe?g(\?|$)/i.test(resolvedOgImage);
const robotsContent = noIndex ? 'noindex, nofollow' : 'index, follow';

// Fecha de última actualización (se actualiza en cada build)
const buildDate = new Date().toISOString();

/** Meta Sharing Debugger pide fb:app_id. Setear PUBLIC_FB_APP_ID en Vercel. */
const fbAppId = import.meta.env.PUBLIC_FB_APP_ID as string | undefined;

// Breadcrumb para SEO
const breadcrumbName = locale === 'es' ? 'Inicio' : 'Home';

// Skills expandidos para knowsAbout
const allSkills = [
  "JavaScript", "TypeScript", "React", "React Native", "Next.js",
  "Node.js", "Express.js", "NestJS", "MongoDB", "PostgreSQL", "SQL",
  "HTML", "CSS", "Tailwind CSS", "Material UI", "Git", "GitHub",
  "Figma", "Jira", "Scrum", "REST API", "Linux", "Fedora"
];
---

<!doctype html>
<html lang={config.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />

    <!-- OG primero: WhatsApp/Meta leen el head temprano y fallan con imagen ?v= o parsers frágiles. -->
    {fbAppId ? <meta property="fb:app_id" content={fbAppId} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={resolvedOgImage} itemprop="image" />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={ogImageIsJpeg ? 'image/jpeg' : 'image/png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${resolvedOgTitle} | arceprog.dev`} />
    <link rel="image_src" href={resolvedOgImage} />
    <meta property="og:site_name" content="arceprog.dev" />
    <meta property="og:locale" content={config.ogLocale} />
    {otherLocales.map(loc => (
      <meta property="og:locale:alternate" content={getLocaleConfig(loc).ogLocale} />
    ))}
    <meta property="og:updated_time" content={buildDate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <meta name="google-site-verification" content="jfdI3O_sVUKVWOWPcViT3dZF-JayDl6N87uwcqGkXXU" />
    <SiteHeadIcons />

    <!-- SEO: Canonical y hreflang (generado dinámicamente para todos los idiomas) -->
    <link rel="canonical" href={canonicalUrl} />
    {LOCALES.map(loc => (
      <link rel="alternate" hreflang={getLocaleConfig(loc).ogLocale.replace('_', '-')} href={localeUrls[loc]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localeUrls[DEFAULT_LOCALE]} />

    <!-- Preload critical resources -->
    <link rel="preload" as="image" href={image} />
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />

    <meta name="robots" content={robotsContent} />
    <meta name="referrer" content="origin-when-cross-origin" />
    <meta http-equiv="content-language" content={locale} />
    <meta name="twitter:site" content="@arceprog" />
    <meta name="twitter:creator" content="@arceprog" />
    <meta property="twitter:domain" content="arceprog.dev" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image:alt" content={`${resolvedOgTitle} | arceprog.dev`} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#121a2b" />

    <meta name="keywords" content={config.keywords} />
    <meta name="author" content="Felipe Arce" />
    <meta name="google" content="nositelinkssearchbox" />
  </head>
  <body>
    <a class="skip-link no-print" href="#contenido">{ui.skipToContent}</a>
    <slot />

    <!-- JSON-LD al final: head liviano para crawlers frágiles (WhatsApp). Google lo lee igual. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Felipe Arce",
      "givenName": "Felipe",
      "familyName": "Arce",
      "jobTitle": config.jobTitle,
      "url": "https://arceprog.dev",
      "image": {
        "@type": "ImageObject",
        "url": "https://arceprog.dev/og-wa.png",
        "width": 1200,
        "height": 630
      },
      "description": config.ogDescription,
      "knowsAbout": allSkills,
      "knowsLanguage": [
        { "@type": "Language", "name": "Spanish", "alternateName": "es" },
        { "@type": "Language", "name": "English", "alternateName": "en" }
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Universidad Tecnológica Nacional",
        "sameAs": "https://www.utn.edu.ar/"
      },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "name": "Técnico Universitario en Programación",
        "credentialCategory": "degree"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "America Virtual",
        "url": "https://americavirtualsa.com/"
      },
      "sameAs": [
        "https://linkedin.com/in/arcefelipe/",
        "https://github.com/arceprogramando"
      ],
      "email": "arceprogramando@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Buenos Aires",
        "addressCountry": "AR"
      }
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Felipe Arce Portfolio",
      "alternateName": "arceprog.dev",
      "url": "https://arceprog.dev",
      "inLanguage": [locale === 'es' ? "es-AR" : "en-US"],
      "author": {
        "@type": "Person",
        "name": "Felipe Arce"
      },
      "dateModified": buildDate
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": breadcrumbName,
          "item": canonicalUrl
        }
      ]
    })} />

    <!-- Detección automática de idioma (solo primera visita) -->
    <script is:inline>
      (function() {
        const path = window.location.pathname;
        const isRoot = path === '/';
        const hasPreference = localStorage.getItem('locale-preference');

        const ua = navigator.userAgent || '';
        const isBot = /bot|crawler|spider|bing|google|slurp|duckduck|whatsapp|facebookexternalhit|facebot/i.test(ua);

        if (isRoot && !hasPreference && !isBot) {
          const lang = navigator.language || navigator.userLanguage || 'es';
          if (!lang.toLowerCase().startsWith('es')) {
            localStorage.setItem('locale-preference', 'en');
            window.location.replace('/en/');
          } else {
            localStorage.setItem('locale-preference', 'es');
          }
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      'Courier New',
      Courier,
      monospace;
    background: var(--color-bg-secondary);
    letter-spacing: -0.025rem;
    scroll-behavior: smooth;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  figure {
    contain: layout style paint;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      'Open Sans',
      'Helvetica Neue',
      sans-serif;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 1000;
    transform: translateY(-200%);
    background: var(--color-bg-dark);
    color: var(--color-text-white);
    padding: 0.5rem 0.75rem;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: none;
  }

  p {
    color: var(--color-text-primary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
