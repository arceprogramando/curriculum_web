---
import CvPrintShell from '@/layouts/CvPrintShell.astro';
import { getCvBuilderUi } from '@/lib/cv-builder-ui';
import type { Locale } from '@/lib/i18n';
import '@/styles/cv-document.css';
import '@/styles/cv-builder.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getCvBuilderUi(locale);
const path = locale === 'en' ? '/en/crear-cv/vista/' : '/crear-cv/vista/';
const pageTitle = `${ui.printPageTitle} | arceprog.dev`;
const ogImageAlt =
  locale === 'en'
    ? 'Open Graph cover for the CV print preview on arceprog.dev'
    : 'Portada Open Graph de la vista de impresión de CV en arceprog.dev';
---

<CvPrintShell
  locale={locale}
  path={path}
  title={pageTitle}
  description={ui.printHint}
  ogTitle={ui.printPageTitle}
  ogDescription={ui.printHint}
  ogImageAlt={ogImageAlt}
>
  <main id="main-content" class="cv-screen-pad" tabindex="-1">
    <div id="cv-builder-print" data-locale={locale}></div>
  </main>
</CvPrintShell>

<script>
  import { mountCvBuilderPrint } from '@/scripts/cv-builder-app';
  import type { Locale } from '@/lib/i18n';

  const root = document.getElementById('cv-builder-print');
  if (!root) throw new Error('cv-builder-print root missing');
  const locale: Locale = root.dataset.locale === 'en' ? 'en' : 'es';
  mountCvBuilderPrint(root, locale);
</script>
