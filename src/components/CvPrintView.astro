---
import CvPrintShell from '@/layouts/CvPrintShell.astro';
import CvDocument from '@/components/CvDocument.astro';
import {
  buildCvPrintModel,
  cvPrintDocumentTitle,
  cvPrintPath,
  cvRoleLabel,
  CV_ROLES,
  type CvRole,
} from '@/lib/cv-print';
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  role?: CvRole;
}

const { locale, role = 'general' } = Astro.props;
const model = buildCvPrintModel(locale, role);
const printFileTitle = cvPrintDocumentTitle(locale, role);
const pageTitle =
  locale === 'en'
    ? `${model.label} CV — Felipe Arce | arceprog.dev`
    : `CV ${model.label} — Felipe Arce | arceprog.dev`;
const ogTitle =
  locale === 'en'
    ? `CV Felipe Arce — ${model.label}`
    : `CV Felipe Arce — ${model.label}`;
const homeHref = locale === 'en' ? '/en/' : '/';
const builderHref = locale === 'en' ? '/en/crear-cv/' : '/crear-cv/';
const builderLabel = locale === 'en' ? 'Build your CV' : 'Armá tu CV';
const description =
  locale === 'en'
    ? `One-page ${model.label} CV for Felipe Arce. Generated from arceprog.dev.`
    : `CV de una hoja (${model.label}) de Felipe Arce. Generado desde arceprog.dev.`;
const ogImageAlt =
  locale === 'en'
    ? `Open Graph cover for Felipe Arce portfolio and ${model.label} CV`
    : `Portada Open Graph del portfolio y CV ${model.label} de Felipe Arce`;
const hintId = 'cv-print-hint';
---

<CvPrintShell
  locale={locale}
  title={pageTitle}
  description={description}
  ogTitle={ogTitle}
  ogDescription={description}
  ogImageAlt={ogImageAlt}
  role={role}
>
  <div class="cv-screen">
    <header class="cv-toolbar no-print">
      <div class="cv-toolbar-nav">
        <a class="cv-back" href={homeHref} title={model.labels.back}>{model.labels.back}</a>
        <a class="cv-builder-link" href={builderHref} title={builderLabel}>{builderLabel}</a>
      </div>

      <nav class="cv-roles" aria-label={model.labels.roleNav}>
        {
          CV_ROLES.map((item) => {
            const label = cvRoleLabel(item, locale);
            const isCurrent = item === role;
            return (
              <a
                href={cvPrintPath(locale, item)}
                class:list={[{ active: isCurrent }]}
                aria-current={isCurrent ? 'page' : undefined}
                aria-label={`${model.labels.roleNav}: ${label}`}
                title={label}
              >
                {label}
              </a>
            );
          })
        }
      </nav>

      <button
        type="button"
        id="cv-print-btn"
        class="cv-print-cta"
        aria-describedby={hintId}
        title={model.labels.savePdf}
      >
        {model.labels.savePdf}
      </button>
      <p id={hintId} class="cv-toolbar-hint">{model.labels.hint}</p>
    </header>

    <main id="main-content" class="cv-paper" tabindex="-1">
      <CvDocument model={model} />
    </main>

    <div class="cv-mobile-cta no-print">
      <button type="button" id="cv-print-btn-mobile" class="cv-print-cta">
        {model.labels.savePdf}
      </button>
    </div>
  </div>
</CvPrintShell>

<script is:inline define:vars={{ printFileTitle, pageTitle }}>
  const triggerPrint = () => {
    document.title = printFileTitle;
    const restore = () => {
      document.title = pageTitle;
    };
    window.addEventListener('afterprint', restore, { once: true });
    window.print();
    window.setTimeout(restore, 1000);
  };

  const bindPrint = (id) => {
    document.getElementById(id)?.addEventListener('click', triggerPrint);
  };
  bindPrint('cv-print-btn');
  bindPrint('cv-print-btn-mobile');

  if (new URLSearchParams(window.location.search).has('print')) {
    window.setTimeout(triggerPrint, 280);
  }
</script>

<style>
  .cv-screen {
    --ui-ink: #161616;
    --ui-line: #cfcbc3;
    --ui-accent: #0b57d0;
    --sticky-h: 4.25rem;
    min-height: 100vh;
    padding: 1rem 1rem calc(var(--sticky-h) + 1.25rem);
  }

  .cv-toolbar {
    max-width: 8.5in;
    margin: 0 auto 1rem;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #fff;
    border: 1px solid var(--ui-line);
    border-radius: 12px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    font-family: 'Source Sans 3', Calibri, Arial, Helvetica, sans-serif;
  }

  .cv-toolbar-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    align-items: center;
  }

  .cv-back,
  .cv-builder-link {
    color: var(--ui-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .cv-back:hover,
  .cv-builder-link:hover {
    text-decoration: underline;
  }

  .cv-roles {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.4rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.15rem;
    scrollbar-width: thin;
  }

  .cv-roles a {
    flex: 0 0 auto;
    text-decoration: none;
    color: #222;
    border: 1px solid #c4c0b6;
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    font-size: 0.84rem;
    font-weight: 600;
    background: #fff;
  }

  .cv-roles a.active {
    background: var(--ui-ink);
    border-color: var(--ui-ink);
    color: #fff;
  }

  .cv-toolbar > .cv-print-cta {
    display: none;
  }

  .cv-print-cta {
    appearance: none;
    border: 0;
    background: var(--ui-ink);
    color: #fff;
    padding: 0.7rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    width: 100%;
    min-height: 2.75rem;
  }

  .cv-print-cta:hover {
    background: #000;
  }

  .cv-toolbar-hint {
    margin: 0;
    color: #4a4a4a;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .cv-paper {
    max-width: 8.5in;
    margin: 0 auto;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 28px rgb(0 0 0 / 0.12);
  }

  .cv-paper:focus {
    outline: none;
  }

  .cv-paper:focus-visible {
    outline: 2px solid var(--ui-accent);
    outline-offset: 3px;
  }

  .cv-mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
    background: rgb(232 230 225 / 0.94);
    border-top: 1px solid var(--ui-line);
    backdrop-filter: blur(8px);
  }

  @media (min-width: 800px) {
    .cv-screen {
      padding: 1.25rem 1rem 2.5rem;
    }

    .cv-toolbar {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'nav cta'
        'roles roles'
        'hint hint';
      align-items: center;
      gap: 0.75rem 1rem;
    }

    .cv-toolbar-nav {
      grid-area: nav;
      justify-content: flex-start;
      gap: 1rem;
    }

    .cv-roles {
      grid-area: roles;
      flex-wrap: wrap;
      overflow: visible;
    }

    .cv-toolbar > .cv-print-cta {
      display: inline-flex;
      grid-area: cta;
      width: auto;
      justify-self: end;
      white-space: nowrap;
    }

    .cv-toolbar-hint {
      grid-area: hint;
    }

    .cv-mobile-cta {
      display: none;
    }
  }

  @media print {
    .cv-screen {
      min-height: 0;
      padding: 0;
    }

    .cv-paper {
      max-width: none;
      box-shadow: none;
    }

    .cv-mobile-cta {
      display: none !important;
    }
  }
</style>
