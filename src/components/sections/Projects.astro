---
import GitHub from '@/icons/GitHub.astro';
import { getCV, getUI, type Locale } from '@/lib/i18n';

interface Props {
  locale?: Locale;
}

interface Project {
  name: string;
  url: string;
  description: string;
  highlights: string[];
  isActive: boolean;
  github?: string;
}

const { locale = 'es' } = Astro.props;
const cv = getCV(locale);
const ui = getUI(locale);
const projects = cv.projects as Project[];
---

<section class="projects">
  <h2>{ui.projects}</h2>
  <ul class="projects-grid">
    {
      projects.map(({ url, description, highlights, name, isActive, github }) => (
        <li>
          <article class:list={['project-card', { 'is-active': isActive }]}>
            <header class="project-card__header">
              <div class="project-card__title-row">
                <h3>
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`${ui.viewProject} ${name}`}
                  >
                    {name}
                  </a>
                  {isActive && (
                    <span class="project-card__live" title={ui.current} aria-label={ui.current}>
                      <span class="project-card__live-dot" aria-hidden="true" />
                    </span>
                  )}
                </h3>
                {
                  github && (
                    <a
                      class="project-card__github"
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`${ui.viewSourceCode} ${name}`}
                      aria-label={`${ui.viewSourceCode} ${name}`}
                    >
                      <GitHub />
                    </a>
                  )
                }
              </div>
              <p>{description}</p>
            </header>
            <footer class="project-card__tags">
              {highlights.map((highlight) => (
                <span>{highlight}</span>
              ))}
            </footer>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    max-width: 920px;
    margin: 0 auto 2rem;
    padding-inline: 0;
  }

  .projects h2 {
    margin: 0 0 1rem;
    font-weight: 700;
    line-height: 1.3;
    font-size: 1.5rem;
    color: var(--color-text-dark);
  }

  .projects-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.15rem 1.15rem 1rem;
    border-radius: 14px;
    background:
      linear-gradient(165deg, rgb(255 255 255 / 0.06), transparent 42%),
      var(--color-bg-dark);
    color: var(--color-text-white);
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.04) inset;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .project-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85rem;
    bottom: 0.85rem;
    width: 3px;
    border-radius: 999px;
    background: transparent;
    transition: background 180ms ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.16);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 12px 28px rgb(18 26 43 / 0.28);
  }

  .project-card:hover::before,
  .project-card:focus-within::before,
  .project-card.is-active::before {
    background: var(--color-status-active);
  }

  .project-card__header {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  .project-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card h3 {
    margin: 0;
    flex: 1;
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .project-card h3 a {
    color: inherit;
    text-decoration: none;
    text-wrap: balance;
  }

  .project-card h3 a:hover,
  .project-card h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-card__live {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-left: 0.4rem;
  }

  .project-card__live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-status-active);
    box-shadow: 0 0 0 3px rgb(64 255 6 / 0.18);
    animation: project-pulse 2.2s ease-in-out infinite;
  }

  .project-card__github {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    color: var(--color-text-inverted);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition:
      color 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .project-card__github:hover {
    color: var(--color-text-white);
    background: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.18);
  }

  .project-card__github :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .project-card p {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-text-inverted);
    text-wrap: pretty;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }

  .project-card__tags span {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.88);
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.1);
  }

  @keyframes project-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.85);
    }
  }

  @media (min-width: 560px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 860px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.05rem;
    }

    .project-card {
      padding: 1.25rem;
    }
  }

  @media (width <= 700px) {
    .projects {
      margin-bottom: 2.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__github,
    .project-card__live-dot {
      transition: none;
      animation: none;
    }

    .project-card:hover,
    .project-card:focus-within {
      transform: none;
    }
  }

  @media print {
    .project-card {
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid #ccc;
      background: #fff;
      color: #111;
    }

    .project-card p,
    .project-card__github {
      color: #333;
    }

    .project-card__tags span {
      color: #111;
      background: #eee;
      border-color: #ddd;
    }

    .project-card__live-dot {
      animation: none;
      background: #0a0;
      box-shadow: none;
    }
  }
</style>
