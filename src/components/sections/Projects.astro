---
import ProjectCard from '@/components/sections/ProjectCard.astro';
import { getCV, getUI, type Locale } from '@/lib/i18n';

interface Props {
  locale?: Locale;
}

interface Project {
  name: string;
  url: string;
  description: string;
  highlights: string[];
  isActive: boolean;
  github?: string;
}

/** Al inicio 2; cada “Ver más” suma 2 más. */
const INITIAL_VISIBLE = 2;
const STEP = 2;

const { locale = 'es' } = Astro.props;
const cv = getCV(locale);
const ui = getUI(locale);
const projects = cv.projects as Project[];

const cardUi = {
  viewProject: ui.viewProject,
  viewSourceCode: ui.viewSourceCode,
  projectLive: ui.projectLive,
};

const showMoreLabel = ui.projectsShowMore;
const showLessLabel = ui.projectsShowLess;
---

<section
  class="projects"
  id={locale === 'en' ? 'projects' : 'proyectos'}
  data-projects-root
  data-initial={INITIAL_VISIBLE}
  data-step={STEP}
  data-label-more={showMoreLabel}
  data-label-less={showLessLabel}
>
  <h2>{ui.projects}</h2>
  <ul class="projects-grid" data-projects-grid>
    {
      projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          collapsed={index >= INITIAL_VISIBLE}
          {...cardUi}
        />
      ))
    }
  </ul>

  {
    projects.length > INITIAL_VISIBLE && (
      <div class="projects-more">
        <button type="button" class="projects-more__btn" data-projects-toggle>
          {showMoreLabel.replace('{count}', String(Math.min(STEP, projects.length - INITIAL_VISIBLE)))}
        </button>
      </div>
    )
  }
</section>

<style>
  .projects {
    --projects-heading: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen,
      Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    --projects-body: Menlo, Monaco, 'Lucida Console', 'Courier New', Courier, monospace;

    width: min(700px, 100%);
    max-width: 700px;
    margin-inline: auto;
    margin-block: 0 2rem;
    padding-inline: 0;
    font-family: var(--projects-body);
    letter-spacing: -0.025rem;
  }

  .projects h2 {
    margin: 0 0 1rem;
    font-family: var(--projects-heading);
    font-weight: 700;
    line-height: 1.3;
    font-size: 1.5rem;
    letter-spacing: normal;
    color: var(--color-text-dark);
  }

  .projects-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.95rem;
  }

  .projects-more {
    margin-top: 1rem;
  }

  .projects-more__btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    font-family: var(--projects-body);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.025rem;
    color: var(--color-text-dark);
    background: var(--color-bg-secondary);
    border: 2.5px solid var(--color-brand-primary);
    border-radius: 16px;
    padding: 0.65rem 1.05rem;
    box-shadow: 3px 3px 0 var(--color-brand-primary);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .projects-more__btn:hover {
    background: var(--color-button-bg);
    border-color: var(--color-button-border);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-brand-primary);
  }

  .projects-more__btn:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
  }

  @media (min-width: 560px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.05rem;
    }
  }

  @media (width <= 700px) {
    .projects {
      margin-bottom: 2.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-more__btn {
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .projects-more__btn:hover {
      transform: none;
      box-shadow: 3px 3px 0 var(--color-brand-primary);
    }
  }

  @media print {
    .projects-more {
      display: none;
    }

    .projects-grid :global(li[hidden]) {
      display: list-item !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects-root]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-projects-toggle]');
  const items = [
    ...document.querySelectorAll<HTMLElement>('[data-projects-grid] [data-project-item]'),
  ];

  if (root && toggle && items.length) {
    const initial = Number(root.dataset.initial ?? 2);
    const step = Number(root.dataset.step ?? 2);
    const labelMore = root.dataset.labelMore ?? 'Ver más ({count})';
    const labelLess = root.dataset.labelLess ?? 'Ver menos';
    let visible = initial;

    const sync = () => {
      items.forEach((el, index) => {
        el.hidden = index >= visible;
      });

      if (visible >= items.length) {
        toggle.textContent = labelLess;
        toggle.setAttribute('aria-expanded', 'true');
        toggle.dataset.mode = 'less';
      } else {
        const next = Math.min(step, items.length - visible);
        toggle.textContent = labelMore.replace('{count}', String(next));
        toggle.setAttribute('aria-expanded', 'false');
        toggle.dataset.mode = 'more';
      }
    };

    toggle.addEventListener('click', () => {
      if (toggle.dataset.mode === 'less') {
        visible = initial;
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        visible = Math.min(items.length, visible + step);
      }
      sync();
    });

    window.addEventListener('beforeprint', () => {
      items.forEach((el) => {
        el.hidden = false;
      });
    });

    window.addEventListener('afterprint', () => {
      sync();
    });

    sync();
  }
</script>
