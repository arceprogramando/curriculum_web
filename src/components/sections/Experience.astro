---
import Section from '../Section.astro';
import { getCV, getUI, type Locale } from '@/lib/i18n';

interface Props {
  locale?: Locale;
}

interface Position {
  title: string;
  startDate: string;
  endDate: string | null;
  description: string;
  skills: string[];
}

interface WorkExperience {
  name: string;
  url: string;
  startDate: string;
  endDate?: string | null;
  position?: string;
  summary?: string;
  positions?: Position[];
}

const { locale = 'es' } = Astro.props;
const cv = getCV(locale);
const ui = getUI(locale);
const work = cv.work as WorkExperience[];

const formatDate = (date: string) => {
  const [year, month] = date.split('-');
  const months: Record<string, Record<string, string>> = {
    es: { '01': 'ene', '02': 'feb', '03': 'mar', '04': 'abr', '05': 'may', '06': 'jun', '07': 'jul', '08': 'ago', '09': 'sep', '10': 'oct', '11': 'nov', '12': 'dic' },
    en: { '01': 'Jan', '02': 'Feb', '03': 'Mar', '04': 'Apr', '05': 'May', '06': 'Jun', '07': 'Jul', '08': 'Aug', '09': 'Sep', '10': 'Oct', '11': 'Nov', '12': 'Dec' }
  };
  return `${months[locale][month]} ${year}`;
};

const companyRange = (positions: Position[]) => {
  const starts = positions.map((p) => p.startDate).sort();
  const ends = positions.map((p) => p.endDate).filter(Boolean).sort() as string[];
  const hasCurrent = positions.some((p) => !p.endDate);
  const from = formatDate(starts[0]);
  const to = hasCurrent ? ui.current : formatDate(ends[ends.length - 1]);
  return `${from} – ${to}`;
};

const uniqueSkills = (positions: Position[], limit = 8) => {
  const seen = new Set<string>();
  const out: string[] = [];
  for (const pos of positions) {
    for (const skill of pos.skills) {
      if (seen.has(skill)) continue;
      seen.add(skill);
      out.push(skill);
      if (out.length >= limit) return out;
    }
  }
  return out;
};
---

<Section title={ui.workExperience}>
  <ul class="work-list">
    {
      work.map((job) => {
        const positions = job.positions ?? [];
        const hasPositions = positions.length > 0;
        const hasPath = hasPositions && positions.length > 1 && Boolean(job.summary);
        const summarySkills = hasPath ? uniqueSkills(positions) : [];

        return (
          <li class="work-item">
            {hasPositions ? (
              <div
                class:list={['company-with-positions', { 'has-path': hasPath }]}
                data-timeline-root={hasPath ? '' : undefined}
                data-label-more={hasPath ? ui.experienceShowMore : undefined}
                data-label-less={hasPath ? ui.experienceShowLess : undefined}
                data-path-label={hasPath ? ui.experiencePathLabel : undefined}
              >
                <div class="company-header">
                  <div class="company-header__row">
                    <h3>
                      <a href={job.url} title={`${ui.visit} ${job.name}`} target="_blank" rel="noopener noreferrer">
                        {job.name}
                      </a>
                    </h3>
                    {hasPath && (
                      <time class="company-range">{companyRange(positions)}</time>
                    )}
                  </div>
                </div>

                {
                  hasPath && (
                    <div class="company-summary-card" data-company-summary>
                      <p class="company-summary">{job.summary}</p>
                      <div class="skills-list">
                        {summarySkills.map((skill) => (
                          <span class="skill-tag">{skill}</span>
                        ))}
                      </div>
                    </div>
                  )
                }

                <div
                  class="timeline-panel"
                  data-timeline-panel
                  hidden={hasPath}
                >
                  {hasPath && (
                    <p class="path-label" data-path-label-el>{ui.experiencePathLabel}</p>
                  )}
                  <ul class="positions-timeline" data-timeline>
                    {positions.map((pos, index) => {
                      const hasMultiple = positions.length > 1;
                      const startFormatted = formatDate(pos.startDate);
                      const endFormatted = pos.endDate ? formatDate(pos.endDate) : ui.current;
                      const isLast = index === positions.length - 1;

                      return (
                        <li
                          class:list={[
                            'position-item',
                            { last: isLast, single: !hasMultiple },
                          ]}
                          data-position-item
                          hidden={hasPath}
                        >
                          <div class="timeline-marker">
                            <div class="dot"></div>
                            <div class="line"></div>
                          </div>
                          <div class="position-content">
                            <div class="position-header">
                              <h4>{pos.title}</h4>
                              <time>{startFormatted} - {endFormatted}</time>
                            </div>
                            <p class="position-description">{pos.description}</p>
                            <div class="skills-list">
                              {pos.skills.map((skill) => (
                                <span class="skill-tag">{skill}</span>
                              ))}
                            </div>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </div>

                {
                  hasPath && (
                    <div class="timeline-more no-print">
                      <button type="button" class="timeline-more__btn" data-timeline-toggle aria-expanded="false">
                        <span class="caret" aria-hidden="true"></span>
                        <span data-timeline-label>
                          {ui.experienceShowMore.replace('{count}', String(positions.length))}
                        </span>
                      </button>
                    </div>
                  )
                }
              </div>
            ) : (
              <article>
                <header>
                  <div>
                    <h3>
                      <a href={job.url} title={`${ui.visit} ${job.name}`} target="_blank" rel="noopener noreferrer">
                        {job.name}
                      </a>
                    </h3>
                    <h4>{job.position}</h4>
                  </div>
                  <div>
                    <time datetime={job.startDate}>
                      {job.startDate.split('-')[0]}
                    </time>
                    {' - '}
                    <time datetime={job.endDate}>
                      {job.endDate ? job.endDate.split('-')[0] : ui.current}
                    </time>
                  </div>
                </header>
                <footer>
                  <p>{job.summary}</p>
                </footer>
              </article>
            )}
          </li>
        );
      })
    }
  </ul>
</Section>

<script>
  const roots = [...document.querySelectorAll<HTMLElement>('[data-timeline-root]')];

  for (const root of roots) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-timeline-toggle]');
    const labelEl = root.querySelector<HTMLElement>('[data-timeline-label]');
    const summary = root.querySelector<HTMLElement>('[data-company-summary]');
    const panel = root.querySelector<HTMLElement>('[data-timeline-panel]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-position-item]')];
    if (!toggle || !labelEl || !summary || !panel || items.length === 0) continue;

    const labelMore = root.dataset.labelMore ?? 'Ver recorrido ({count})';
    const labelLess = root.dataset.labelLess ?? 'Ver resumen';
    let visible = 0;
    let expanded = false;
    let revealing = false;

    const syncLast = () => {
      items.forEach((el, index) => {
        el.classList.toggle('last', index === Math.max(visible - 1, 0));
        el.classList.toggle('single', visible <= 1);
      });
    };

    const syncButton = () => {
      if (!expanded) {
        labelEl.textContent = labelMore.replace('{count}', String(items.length));
        toggle.setAttribute('aria-expanded', 'false');
        toggle.classList.remove('is-expanded');
        toggle.dataset.mode = 'more';
        return;
      }

      if (visible >= items.length) {
        labelEl.textContent = labelLess;
        toggle.setAttribute('aria-expanded', 'true');
        toggle.classList.add('is-expanded');
        toggle.dataset.mode = 'less';
      } else {
        const remaining = items.length - visible;
        labelEl.textContent = labelMore.replace('{count}', String(remaining));
        toggle.setAttribute('aria-expanded', 'true');
        toggle.classList.add('is-expanded');
        toggle.dataset.mode = 'more';
      }
    };

    const showSummary = () => {
      expanded = false;
      visible = 0;
      summary.hidden = false;
      summary.classList.remove('is-leaving');
      panel.hidden = true;
      items.forEach((el) => {
        el.hidden = true;
        el.classList.remove('is-revealing', 'is-extending');
      });
      syncButton();
    };

    const revealNext = async () => {
      if (revealing) return;

      if (!expanded) {
        expanded = true;
        summary.classList.add('is-leaving');
        await new Promise((r) => window.setTimeout(r, 180));
        summary.hidden = true;
        summary.classList.remove('is-leaving');
        panel.hidden = false;
        panel.classList.add('is-open');
      }

      if (visible >= items.length) {
        syncButton();
        return;
      }

      revealing = true;
      const prev = visible > 0 ? items[visible - 1] : null;
      prev?.classList.remove('last');
      prev?.classList.add('is-extending');

      const next = items[visible];
      next.hidden = false;
      next.classList.add('is-revealing');
      visible += 1;
      syncLast();
      syncButton();

      await new Promise<void>((resolve) => {
        const done = () => {
          next.classList.remove('is-revealing');
          prev?.classList.remove('is-extending');
          next.removeEventListener('animationend', done);
          resolve();
        };
        next.addEventListener('animationend', done);
        window.setTimeout(done, 520);
      });

      revealing = false;
    };

    toggle.addEventListener('click', () => {
      if (toggle.dataset.mode === 'less') {
        showSummary();
        root.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        void revealNext();
      }
    });

    window.addEventListener('beforeprint', () => {
      summary.hidden = false;
      panel.hidden = false;
      items.forEach((el) => {
        el.hidden = false;
        el.classList.remove('is-revealing', 'is-extending');
      });
    });

    window.addEventListener('afterprint', () => {
      if (expanded) {
        summary.hidden = true;
        panel.hidden = false;
        items.forEach((el, index) => {
          el.hidden = index >= visible;
        });
        syncLast();
      } else {
        showSummary();
      }
      syncButton();
    });

    showSummary();
  }
</script>

<style>
  .work-list {
    margin: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .work-item {
    list-style: none;
  }

  .company-with-positions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .company-header__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .company-header h3 {
    font-weight: 600;
    color: var(--color-text-dark);
    font-size: 1.1rem;
  }

  .company-header a {
    color: var(--color-text-dark);
  }

  .company-header a:hover {
    text-decoration: underline;
  }

  .company-range {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .company-summary-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .company-summary-card.is-leaving {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .company-summary {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .path-label {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  .timeline-panel[hidden] {
    display: none;
  }

  .timeline-panel.is-open {
    animation: panel-in 0.25s ease-out both;
  }

  .positions-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 8px;
    position: relative;
  }

  .position-item {
    display: flex;
    gap: 16px;
    list-style: none;
    position: relative;
  }

  .position-item[hidden] {
    display: none;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 12px;
    position: relative;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: var(--color-text-secondary);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
    z-index: 1;
  }

  .line {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    transform-origin: top center;
    width: 2px;
    height: calc(100% + 20px);
    background-color: var(--color-text-secondary);
  }

  .position-item.last .line {
    height: 20px;
  }

  .position-item.single .line {
    height: 20px;
  }

  .position-content {
    flex: 1;
    padding-bottom: 20px;
  }

  .position-item.last .position-content {
    padding-bottom: 0;
  }

  .position-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .position-header h4 {
    font-weight: 500;
    color: var(--color-text-dark);
    font-size: 0.95rem;
  }

  .position-header time {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .position-description {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .skill-tag {
    background-color: var(--color-bg-badge);
    color: var(--color-text-inverted);
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
  }

  .timeline-more {
    margin-top: 4px;
  }

  .timeline-more__btn {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    padding: 0.15rem 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-text-dark);
    background: transparent;
    border: 0;
  }

  .timeline-more__btn:hover {
    text-decoration: underline;
  }

  .timeline-more__btn:focus-visible {
    outline: 2px solid var(--color-text-dark);
    outline-offset: 2px;
  }

  .timeline-more__btn .caret {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .timeline-more__btn.is-expanded .caret {
    transform: rotate(45deg);
  }

  .position-item.is-extending .line {
    animation: line-extend 0.4s ease-out both;
  }

  .position-item.is-revealing {
    animation: position-flow-in 0.45s ease-out both;
  }

  .position-item.is-revealing .dot {
    animation: dot-pop 0.35s ease-out both;
  }

  .position-item.is-revealing .line {
    animation: line-grow 0.45s ease-out both;
  }

  .position-item.is-revealing .position-content {
    animation: content-fade 0.4s ease-out 0.08s both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes line-extend {
    from {
      height: 20px;
    }
    to {
      height: calc(100% + 20px);
    }
  }

  @keyframes line-grow {
    from {
      transform: translateX(-50%) scaleY(0);
      opacity: 0.35;
    }
    to {
      transform: translateX(-50%) scaleY(1);
      opacity: 1;
    }
  }

  @keyframes position-flow-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dot-pop {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes content-fade {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  article header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  article h3 {
    font-weight: 600;
    color: var(--color-text-dark);
    font-size: 1.1rem;
    padding-bottom: 4px;
  }

  article h4 {
    font-weight: 500;
    color: var(--color-text-dark);
    font-size: 0.95rem;
  }

  article a {
    color: var(--color-text-dark);
  }

  article a:hover {
    text-decoration: underline;
  }

  article footer p {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-top: 8px;
  }

  @media (width <= 700px) {
    .company-header a,
    article a {
      text-decoration: underline;
    }

    .company-header__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .position-header {
      flex-direction: column;
      gap: 2px;
    }

    .position-header time {
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-summary-card.is-leaving,
    .timeline-panel.is-open,
    .position-item.is-revealing,
    .position-item.is-revealing .dot,
    .position-item.is-revealing .line,
    .position-item.is-revealing .position-content,
    .position-item.is-extending .line {
      animation: none;
      transition: none;
    }

    .timeline-more__btn .caret {
      transition: none;
    }
  }

  @media print {
    .company-summary-card,
    .timeline-panel,
    .position-item {
      display: block !important;
    }

    .position-item {
      display: flex !important;
    }

    .timeline-more {
      display: none;
    }
  }
</style>
